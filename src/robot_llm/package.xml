<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_llm</name>
  <version>0.1.0</version>
  <description>LLM bridge package translating user natural language into structured task plans (based on Mike Likes Robots llm-robot-control patterns).</description>
  <maintainer email="user@todo.todo">Gaspard</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
