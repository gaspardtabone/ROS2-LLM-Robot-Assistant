<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="appartement">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo Fortress System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sol / Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Appartement Outer & Inner Walls -->
    <!-- Outer Walls Box 10x8m -->
    <model name="apartment_walls">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>

      <!-- North Wall -->
      <link name="wall_north">
        <pose>0 4 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>10 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.2 2.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
      <!-- South Wall -->
      <link name="wall_south">
        <pose>0 -4 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>10 0.2 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.2 2.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
      <!-- East Wall -->
      <link name="wall_east">
        <pose>5 0 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8 2.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
      <!-- West Wall -->
      <link name="wall_west">
        <pose>-5 0 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 8 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8 2.5</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>

      <!-- Room Divider Wall (Kitchen / Living Room) -->
      <link name="wall_kitchen_divider">
        <pose>1.0 1.5 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 5 2.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 5 2.5</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <!-- Table in Kitchen -->
    <model name="kitchen_table">
      <static>true</static>
      <pose>3.0 2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.8 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 0.8 0.8</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Target Object (Bottle) on Kitchen Table -->
    <model name="target_bottle">
      <static>false</static>
      <pose>3.0 2.5 0.95 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.25</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.25</length></cylinder></geometry><material><ambient>0.1 0.7 0.2 1</ambient></material></visual>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.0005</izz></inertia></inertial>
      </link>
    </model>

  </world>
</sdf>
